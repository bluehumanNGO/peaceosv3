{
  "name": "@peaceos/core",
  "version": "0.1.0",
  "private": true,
  "description": "Reference TypeScript library: hashing, signing, timestamping, build-package and verify-package logic.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    },
    "./file-tree": {
      "types": "./dist/file-tree.d.ts",
      "default": "./dist/file-tree.js"
    },
    "./node-file-tree": {
      "types": "./dist/node-file-tree.d.ts",
      "default": "./dist/node-file-tree.js"
    },
    "./timestamp-node": {
      "types": "./dist/timestamp-node.d.ts",
      "default": "./dist/timestamp-node.js"
    },
    "./timestamp-offline": {
      "types": "./dist/timestamp-offline.d.ts",
      "default": "./dist/timestamp-offline.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@peaceos/spec": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^4.0.0",
    "libsodium-wrappers": "0.7.16",
    "opentimestamps": "^0.4.9"
  },
  "devDependencies": {
    "@types/opentimestamps": "^0.4.0"
  }
}
